{
  "name": "sunpeak-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-maplibre.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-maplibre.mjs",
    "build": "next build",
    "start": "next start",
    "check:unused": "knip",
    "format": "biome check --write .",
    "type-check": "tsc --noEmit",
    "lint": "next typegen && biome ci . && npm run type-check && npm run check:unused",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "map:style": "node scripts/build-map-style.mjs"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "dependencies": {
    "@googleapis/sheets": "18.1.1",
    "@vercel/analytics": "^2.0.0",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.12.0",
    "next": "^16.1.1",
    "proj4": "^2.9.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/leaflet": "1.9.22",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "30.1.3",
    "knip": "6.42.1",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
