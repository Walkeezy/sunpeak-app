{
  "name": "sunpeak-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check:unused": "knip",
    "format": "biome check --write .",
    "type-check": "tsc --noEmit",
    "lint": "next typegen && biome ci . && npm run type-check && npm run check:unused",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.0",
    "googleapis": "176.0.0",
    "leaflet": "^1.9.4",
    "next": "^16.1.1",
    "proj4": "^2.9.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@tailwindcss/postcss": "4.3.3",
    "@types/leaflet": "1.9.22",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/coverage-v8": "4.1.11",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "knip": "6.34.0",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
